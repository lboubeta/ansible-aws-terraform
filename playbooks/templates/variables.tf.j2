variable "name_prefix" {
  description = "Prefix used for naming resources"
  type        = string
  default     = "{{ name_prefix | default('logista') }}"
}

variable "vm_name" {
  description = "Name for the vm based on project and type"
  type        = string
  default     = "{{ type | default('linux') }}_{{ name_prefix | default('logista') }}"
}

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "{{ aws_region | default('eu-west-1') }}"
}

variable "aws_az_suffix" {
  description = "AZ suffix appended to region to form availability_zone (eg 'a')"
  type        = string
  default     = "{{ aws_az_suffix | default('a') }}"
}

variable "cidr_block" {
  description = "VPC CIDR block"
  type        = string
  default     = "{{ cidr_block | default('10.0.0.0/16') }}"
}

variable "subnet_cidr" {
  description = "Subnet CIDR block"
  type        = string
  default     = "{{ subnet_cidr | default('10.0.1.0/24') }}"
}

variable "map_public_ip_on_launch" {
  description = "Whether subnet auto-assigns public IPs"
  type        = bool
  default     = {{ map_public_ip_on_launch | default(true) | tojson }}
}

variable "vm_count" {
  description = "Number of instances to create"
  type        = number
  default     = {{ vm_count | default(1) | int }}

  validation {
    condition     = var.vm_count >= 1
    error_message = "vm_count must be >= 1"
  }
}

variable "instance_type" {
  description = "Instance type for EC2/GCP/Azure VMs"
  type        = string
  default     = "{{ instance_type | default('t3.medium') }}"
}

variable "ami_id" {
  description = "Optional AMI id override; leave empty to use AMI data lookup"
  type        = string
  default     = "{{ ami_id | default('') }}"
}

variable "rhel9_owner" {
  description = "Owner ID used when looking up RHEL9 AMI"
  type        = string
  default     = "{{ rhel9_owner | default('309956199498') }}"
}

variable "win25_owner" {
  description = "Owner ID used when looking up WIN-Server-2025 AMI"
  type        = string
  default     = "{{ rhel9_owner | default('801119661308') }}"
}


variable "key_name" {
  description = "SSH key pair name in AWS"
  type        = string
  default     = "{{ name_prefix }}_key"
}

variable "public_key_path" {
  description = "Local path to public key file (used by aws_key_pair)"
  type        = string
  default     = "{{ public_key_path | default('../../.ssh/aws_test_id_rsa.pub') }}"
}

variable "private_key_path" {
  description = "Local path to private key file (used in ssh command output)"
  type        = string
  default     = "{{ private_key_path | default('../../.ssh/aws_test_id_rsa') }}"
}

variable "ssh_user" {
  description = "Username for SSH connections (used in output strings and metadata)"
  type        = string
  default     = "{{ ssh_user | default('ec2-user') }}"
}

variable "create_public_ip" {
  description = "Allocate Elastic IPs for instances when true"
  type        = bool
  default     = {{ create_public_ip | default(true) | tojson }}
}

variable "dns_domain" {
  description = "DNS domain used when creating per-instance records (eg example.com)"
  type        = string
  default     = "{{ dns_domain | default('') }}"
}

variable "dns_zone_id" {
  description = "Route53 hosted zone id (eg ZXXXXXXXX). Leave empty to skip DNS record creation."
  type        = string
  default     = "{{ dns_zone_id | default('') }}"
}

variable "tags" {
  description = "Map of tags to apply to resources"
  type        = map(string)
  default     = {{ tags | default({}) | tojson }}
}

variable "extra_ingress_rules" {
  description = "List of additional ingress rules to add to the security group"
  type = list(object({
    description = string
    from_port   = number
    to_port     = number
    protocol    = string
    cidr_blocks = list(string)
  }))
  default = {{ extra_ingress_rules | default([]) | tojson }}
}

variable "user_data" {
  description = "Instance user_data (cloud-init or shell script)"
  type        = string
  default     = <<-EOT
{{ user_data | default("#!/bin/bash\necho \"Sistema iniciado correctamente\" > /root/startup.log\n") }}
  EOT
}

# --- Backend / state store ---
variable "backend_s3_bucket" {
  description = "S3 bucket name to store Terraform state (backend)"
  type        = string
  default     = "{{ backend_s3_bucket | default('') }}"
}

variable "backend_s3_key" {
  description = "S3 key (path) for the state file, e.g. \"path/to/terraform.tfstate\""
  type        = string
  default     = "{{ backend_s3_key | default(name_prefix ~ '/terraform.tfstate') }}"
}

variable "backend_region" {
  description = "Region for the S3 backend (defaults to aws_region)"
  type        = string
  default     = "{{ backend_region | default(aws_region | default('')) }}"
}

variable "backend_encrypt" {
  description = "Enable server-side encryption for backend (S3)"
  type        = bool
  default     = {{ backend_encrypt | default(true) | tojson }}
}

variable "backend_dynamodb_table" {
  description = "DynamoDB table name to use for state locking (optional)"
  type        = string
  default     = "{{ backend_dynamodb_table | default('') }}"
}

variable "create_backend_resources" {
  description = "If true create the S3 bucket and optional DynamoDB table in this configuration (bootstrap caveat)"
  type        = bool
  default     = {{ create_backend_resources | default(false) | tojson }}
}

